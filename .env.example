# Copy to .env and change what you need. lab.sh and docker compose both read .env.
VAULT_PORT=8200
VAULT2_PORT=8210
VAULT3_PORT=8220
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
WAZUH_PORT=8443
WAZUH_AGENT_PORT=1514
WAZUH_ENROLL_PORT=1515
# second cluster (./lab.sh multicloud up)
VAULTB1_PORT=8300
VAULTB2_PORT=8310
VAULTB3_PORT=8320
# VAULTB_VERSION=1.19.5
# IaC pipeline (./lab.sh iac up)
# GITHUB_REPO=FlavioImbertDomingos/vault-observability-lab   # set to your fork's owner/name
TFSTATE_PORT=5433
# TFSTATE_DB_PASSWORD=terraform-lab
# RUNNER_VERSION=2.338.2
# Keycloak OIDC provider (./lab.sh oidc up)
KEYCLOAK_PORT=8180
